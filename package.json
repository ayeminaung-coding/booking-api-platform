{
  "name": "equipment-booking-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "db:migrate:local": "wrangler d1 execute booking-db --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute booking-db --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  },
  "dependencies": {
    "hono": "^4.6.10"
  }
}
